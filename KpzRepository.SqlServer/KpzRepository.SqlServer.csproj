<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>KpzRepository.SqlServer</AssemblyTitle>
    <ApplicationIcon>KpzRepository_lib_icon.ico</ApplicationIcon>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Repository pattern implementation for MS SQL Server</Title>
    <Authors>maxim.mihaluk</Authors>
    <Description>Repository pattern implementation for MS SQL Server</Description>
    <Copyright>maxim.mihaluk</Copyright>
    <PackageIcon>KpzRepository_lib_icon.png</PackageIcon>
    <PackageProjectUrl>kpzrepository.com</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/malicone/KpzRepository</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>repository-pattern;database;sqlserver;postgresql;sqlite</PackageTags>
    <PackageReleaseNotes>Initial build</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="KpzRepository_lib_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\images\KpzRepository_lib_icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KpzRepository\KpzRepository.csproj" />
  </ItemGroup>

</Project>
